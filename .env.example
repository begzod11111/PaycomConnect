PORT=9010
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:9000,http://0.0.0.0:9000,https://tamada.monitoring-jira.uz

# MongoDB
MONGODB_URI=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_BRIDGE_BOT_NAME=
SLACK_BRIDGE_BOT_ICON_EMOJI=
ONBOARDING_CHANNEL_ID=

# JIRA
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Forwarding behavior
ENABLE_LIVE_FORWARDING=false

TELEGRAM_API_URL=
SLACK_API_URL=

# ngrok public tunnel (for local dev so Telegram/Slack webhooks reach your machine).
# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved/custom domain (paid ngrok plans), e.g. myapp.ngrok-free.app
NGROK_DOMAIN=
# Leave empty to auto-open a tunnel outside production when NGROK_AUTHTOKEN is set.
# Set to true/false to force-enable or force-disable.
NGROK_ENABLED=

TELEGRAM_CHANNEL_ID=-
PROD=-
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=
SLACK_BOT_ID=

# Telegram bot setup (scripts/setup-telegram.js)
# Public HTTPS URL of POST /api/telegram/webhook, e.g. https://your-domain/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Service-to-service auth (Balancer -> PaycomConnect). See docs/service-auth.md
# Name of THIS service; checked against the X-Target-Service header when present.
SERVICE_NAME=paycomconnect
# Trusted callers as "name:secret" pairs, comma-separated. Generate a key with:
#   npm run gen:service-key balancer
# Enforcement turns on automatically once at least one client is configured.
SERVICE_CLIENTS=
# Optional override: true/false to force-enable or force-disable enforcement.
SERVICE_AUTH_ENABLED=
