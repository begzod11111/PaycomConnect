{
  "name": "paycomconnect",
  "version": "0.1.0",
  "description": "PaycomConnect — NestJS bridge between Telegram, Slack and Jira (CRM/analytics)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "setup:telegram": "node ./scripts/setup-telegram.mjs",
    "gen:service-key": "node ./scripts/gen-service-key.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.4.0",
    "@ngrok/ngrok": "^1.7.0",
    "axios": "^1.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "mongoose": "^8.13.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
